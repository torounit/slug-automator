{
	"name": "slug-automator",
	"version": "0.6.0",
	"description": "Automates slug generation for WordPress posts.",
	"author": "Toro_Unit",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"slug",
		"ai"
	],
	"homepage": "https://github.com/torounit/slug-automator",
	"repository": {
		"type": "git",
		"url": "https://github.com/torounit/slug-automator.git"
	},
	"bugs": "https://github.com/torounit/slug-automator/issues",
	"dependencies": {
		"@wordpress/abilities": "^0.23.0",
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/editor": "^15.2.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/notices": "^5.57.0",
		"@wordpress/plugins": "^7.57.0"
	},
	"devDependencies": {
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@wordpress/env": "^11.17.0",
		"@wordpress/prettier-config": "^4.57.0",
		"@wordpress/scripts": "^36.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"npm-run-all": "^4.1.5",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js",
		"lint:type": "tsc",
		"lint:style": "wp-scripts lint-style",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"lint:md": "wp-scripts lint-md-docs",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"wp-env": "wp-env",
		"test:php": "npm-run-all test:php:setup test:php:base",
		"test:php:setup": "wp-env --config=.wp-env.test.json start",
		"test:php:base": "wp-env --config=.wp-env.test.json run --env-cwd='wp-content/plugins/slug-automator' wordpress vendor/bin/phpunit -c phpunit.xml.dist",
		"prepare": "husky"
	},
	"private": true,
	"lint-staged": {
		"*.php": [
			"sh -c 'vendor/bin/phpcbf \"$@\" || true' --",
			"vendor/bin/phpcs"
		],
		"*.{js,ts,json,yaml,yml}": "wp-scripts format",
		"*.{js,ts}": [
			"wp-scripts lint-js",
			"npm run lint:type"
		],
		"*.{css,scss}": "wp-scripts lint-style",
		"package.json": "wp-scripts lint-pkg-json"
	}
}
